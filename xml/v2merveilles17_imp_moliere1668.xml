        <docTitle>
          <titlePart>LE GRAND DIVERTISSEMENT ROYAL DE <placeName key="versailles">VERSAILLES</placeName>.</titlePart>
        </docTitle>
        <docImprint>A <placeName key="paris">PARIS</placeName>,</docImprint>
